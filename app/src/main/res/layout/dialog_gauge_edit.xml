<?xml version="1.0" encoding="utf-8"?>
<com.icar.obd.ui.view.MaxWidthScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    app:maxWidthDp="520dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="0dp"
            android:text="数据通道" />

        <Spinner
            android:id="@+id/spPid"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_input" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="样式" />

        <Spinner
            android:id="@+id/spStyle"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_input" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="占位宽度" />

        <Spinner
            android:id="@+id/spSpan"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_input" />
        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="霓虹效果（只作用于这一块表）" />

        <Spinner
            android:id="@+id/spNeon"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_input" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="卡片外框（只作用于这一块表）" />

        <Spinner
            android:id="@+id/spCard"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_input" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="最小值" />

                <EditText
                    android:id="@+id/etMin"
                    style="@style/InputEditMono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal|numberSigned" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="最大值" />

                <EditText
                    android:id="@+id/etMax"
                    style="@style/InputEditMono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal|numberSigned" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="报警下限（可空）" />

                <EditText
                    android:id="@+id/etWarnLow"
                    style="@style/InputEditMono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal|numberSigned" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="报警上限（可空）" />

                <EditText
                    android:id="@+id/etWarnHigh"
                    style="@style/InputEditMono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal|numberSigned" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.icar.obd.ui.view.MaxWidthScrollView>
