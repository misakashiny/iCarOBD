<?xml version="1.0" encoding="utf-8"?>
<!-- 日志页根容器限宽居中（900dp：日志行较长，比列表页稍宽） -->
<com.icar.obd.ui.view.MaxWidthLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center_horizontal"
    android:background="@color/bg"
    android:orientation="vertical"
    app:maxWidthDp="900dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp">

        <Spinner
            android:id="@+id/spLevel"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input" />

        <Spinner
            android:id="@+id/spModule"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_input" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogPause"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="暂停滚动"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogExport"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="导出"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogClear"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="清空"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLogStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="0 条"
        android:textColor="@color/text_dim"
        android:textSize="11sp" />

    <!--
      列表区（v1.20.17 改成 FrameLayout 叠放）：
      空态与列表**叠在同一块**里，不是上下平分 —— 两个都写 `weight=1` 的话，
      空的时候列表那半屏会留一块空白，看起来像"列表坏了"。
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLogs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />

        <!--
          空态（v1.20.17，规格 §3）：**为什么空 + 下一步做什么**。
          三种原因（还没产生 / 级别筛掉了 / 模块筛掉了）文案完全不同 ——
          只写"暂无数据"的话用户只能猜，而猜错的代价是"以为日志丢了"。
          可见性只在每 250ms 的合并刷新里翻一次（性能红线，见 LogViewText）。
        -->
        <TextView
            android:id="@+id/tvLogEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingTop="18dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"
            android:visibility="gone" />
    </FrameLayout>
    <!--
      v1.20.3：原来这里有个「知识库」按钮（点了开 Activity）。
      用户要求"知识库不是在日志里进入、而是直接增加个 tab 标签" —— 已改成导航栏的一个 tab，
      这里不再留入口（同一个功能两个入口 = 两份权威的轻量版）。
    -->
</com.icar.obd.ui.view.MaxWidthLinearLayout>
