<?xml version="1.0" encoding="utf-8"?>
<!--
  仪表盘页（v1.20.0：多画布）。

  ## 这一版删掉了什么，为什么

  旧版顶部有一行「普通 / 性能 / 自定义 + 布局 / 风格 / 编辑」。
  v1.19.25 删掉了 App 的状态条之后，那一行就成了整页里**唯一的**横条 ——
  而它占的是最宝贵的一行高度（实测 65px 的画布），换来的却只是三个页签。

  现在改成：**整页横滑** ——
  `[画布0][画布1]…[设置]`，页码变化即切 `Store.settings.activeCanvasId`。
  原「布局 / 风格」的全部能力搬进了最后那一页「设置」，
  「编辑」变成画布页右下角的一个按钮（就地编辑，见 fragment_dash_canvas.xml）。

  ## 为什么告警条还在外面

  它是**跨画布**的（规则触发与哪一套画布无关），放在 pager 之外
  才不会因为翻页被重建、也不会在翻页动画里跟着平移。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 规则触发的提示条 -->
    <TextView
        android:id="@+id/alertBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_banner"
        android:padding="8dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:visibility="gone" />

    <!--
        画布 + 设置页。适配器见 ui/dash/DashCanvasPagerAdapter.kt。

        `layout_weight=1` 而不是固定高度：告警条出现时 pager 自己让位，
        不用手算高度（旧版也是这个结构）。
    -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/dashPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
