<?xml version="1.0" encoding="utf-8"?>
<!--
  CAN 总线被动探测。结果行代码生成（每个 CAN ID 一行）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSniffToggle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="2"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:text="开始探测"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSniffClear"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="清空"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="采集"
            android:textSize="11sp" />

        <Spinner
            android:id="@+id/spSniffDuration"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="4dp" />

        <!--
          分段轮换扫描（v1.20.10，P12-S5）：8 段 × 10 秒，自动换段，一轮约 90 秒。
          勾上之后「采集」下拉框不起作用 —— 时长由轮换自己决定（每段 10 秒）。
          为什么不做成下拉框里的一项「8×10 秒」：那样会让人以为可以调
          「每段几秒」，而轮换的每段时长是规格里定死的（10 秒才能采到慢周期报文）。
        -->
        <CheckBox
            android:id="@+id/cbSniffRotate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="2dp"
            android:text="分段轮换"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSniffExportAgg"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.4"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="导出观察表"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSniffExportRaw"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1.4"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="导出原始帧"
            android:textSize="11sp" />
    </LinearLayout>

    <!--
      信号表（v1.20.7，S1）：观察表是「原始材料」、信号表是「结论」——
      对象不同，所以刻意做成两个文件，不混在一张表里。
      模板 25 列、每个观察到的 CAN ID 一行，预填 ID/DLC/取值集合，在电脑上填完再导回来。
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSniffExportTemplate"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.4"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="导出信号表模板"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSniffImportSignal"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1.4"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="导入信号表"
            android:textSize="11sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="过滤器"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/etSniffFilter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="留空=全收；也可只填一个 ID（如 09A）"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLength="40"
            android:paddingStart="4dp"
            android:textSize="11sp" />
    </LinearLayout>

    <!--
      过滤器说明（v1.20.17）：这条预设**能看到什么** + **实际会下发的 AT 命令**。
      规格 §2 的判据之一就是"选中后状态行显示实际下发的 AT 命令" ——
      没有这一行，用户选完只知道输入框里多了一串看不懂的字母。
      文本由 CanFilterPresets.describe() 算出来（纯函数，与真正下发的那段同一套规则）。
    -->
    <TextView
        android:id="@+id/tvSniffFilterStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="2dp"
        android:paddingEnd="12dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <!--
      ⚠️ ATCF000 是全总线、不是"第 0 段"（v1.20.17，规格 §2 点名要写清）。
      只在**可能被误读的两种状态**下出现（不过滤 / 选了全总线那条），其余状态 GONE。
    -->
    <TextView
        android:id="@+id/tvSniffFilterNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="2dp"
        android:paddingEnd="12dp"
        android:textColor="@color/text_dim"
        android:textSize="10sp"
        android:visibility="gone" />

    <!--
      过滤预设（v1.19.22）：点一下就把上面的输入框填好。

      为什么需要：过滤器的语法（`ATCRA228` / `ATCM700+ATCF400`）**不好记**，
      而它又是"能不能看清闪烁类信号"的前提 ——
      实测过滤后单 ID 采样率从 0.7 帧/秒 提到 20 帧/秒。
      让人去翻文档记语法，不如点一下。
    -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgFilterPresets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="false" />
    </HorizontalScrollView>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSniffDiff"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="对比基准（找位）"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMonitorToggle"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="开启常驻监听（转向灯）"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvSniffStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textColor="@color/text_dim"
        android:textSize="11sp" />

    <!--
      轮换进度（v1.20.10）：第几段 / 还剩多久 / 已收多少 ID。
      **单独一行、单独的颜色**，不能并进上面那行状态里 ——
      轮换一轮要 80~90 秒，用户全程盯着一片空白，进度必须一眼可见。
      不是轮换时这一行是 GONE（不占高度，也不留一行空白）。
    -->
    <TextView
        android:id="@+id/tvSniffRotate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.icar.obd.ui.view.ColumnFlowLayout
                android:id="@+id/sniffResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="16dp" />

            <LinearLayout
                android:id="@+id/sniffDiffs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="16dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
