<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:id="@+id/sniffHeader" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginBottom="8dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginEnd="8dp" android:orientation="vertical" android:gravity="center_vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="CAN 探测" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:id="@+id/tvSniffPhase" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp" android:text="待开始" android:textColor="@color/text_secondary" android:textSize="12sp" />
                <TextView android:id="@+id/tvSniffConnection" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:singleLine="true" android:ellipsize="end"
                    android:text="检查连接中" android:textColor="@color/text_secondary" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSniffToggle" android:layout_width="120dp" android:layout_height="48dp"
            android:paddingStart="12dp" android:paddingEnd="12dp" android:minWidth="0dp"
            android:text="开始采集" android:textSize="14sp" android:insetTop="0dp" android:insetBottom="0dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSniffDetails" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="56dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:minWidth="0dp"
            android:paddingStart="8dp" android:paddingEnd="8dp" android:text="详情" android:textSize="13sp"
            android:contentDescription="展开采集详情" android:insetTop="0dp" android:insetBottom="0dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSniffBack" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="56dp" android:layout_height="48dp" android:layout_marginStart="4dp" android:minWidth="0dp"
            android:paddingStart="8dp" android:paddingEnd="8dp" android:text="返回" android:textSize="13sp"
            android:insetTop="0dp" android:insetBottom="0dp" />
    </LinearLayout>
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/sniffProgress"
        android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginBottom="8dp"
        app:indicatorColor="@color/accent" app:trackColor="@color/divider" android:visibility="gone" />
    <com.google.android.material.card.MaterialCardView android:id="@+id/sniffStatusDetails"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"
        android:layout_marginBottom="8dp" app:cardCornerRadius="12dp" app:cardElevation="0dp"
        app:cardBackgroundColor="@color/bg_surface" app:strokeWidth="1dp" app:strokeColor="@color/divider">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
            <TextView android:id="@+id/tvSniffStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/text_secondary" android:textSize="13sp" android:lineSpacingExtra="2dp" />
            <TextView android:id="@+id/tvSniffRotate" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textColor="@color/accent" android:textSize="13sp" android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout android:id="@+id/sniffColumns" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical">
        <ScrollView android:id="@+id/sniffSettingsScroll" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="vertical" android:fillViewport="false">
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/bg_surface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="采集设置"
                        android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:layout_marginTop="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="采集时长" android:textSize="14sp" />
                        <Spinner android:id="@+id/spSniffDuration" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" />
                    </LinearLayout>
                    <CheckBox android:id="@+id/cbSniffRotate" android:layout_width="match_parent" android:layout_height="48dp"
                        android:text="分段扫描 · 8段，每段10秒" android:textSize="14sp" android:paddingStart="0dp" />
                    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:hint="CAN ID 或接收过滤组合">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSniffFilter"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                            android:inputType="textCapCharacters|textNoSuggestions" android:maxLength="40" android:textSize="14sp"
                            android:importantForAutofill="no" android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView android:id="@+id/tvSniffFilterStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:textColor="@color/text_secondary" android:textSize="13sp" android:lineSpacingExtra="2dp" />
                    <com.google.android.material.chip.ChipGroup android:id="@+id/cgFilterPresets"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        app:singleLine="false" app:singleSelection="true" app:chipSpacingHorizontal="4dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSniffRanges"
                        style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="更多 ID 范围" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSniffTools"
                        style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="文件与常驻监听" />
                    <LinearLayout android:id="@+id/sniffToolsBody" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:visibility="gone">
                        <com.icar.obd.ui.view.ColumnFlowLayout android:id="@+id/sniffFileActions" android:layout_width="match_parent" android:layout_height="wrap_content">
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnSniffExportAgg"
                                style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="48dp"
                                android:text="导出观察表" android:textSize="13sp" android:insetTop="0dp" android:insetBottom="0dp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnSniffExportRaw"
                                style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="48dp"
                                android:text="导出原始帧" android:textSize="13sp" android:insetTop="0dp" android:insetBottom="0dp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnSniffExportTemplate"
                                style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="48dp"
                                android:text="导出信号模板" android:textSize="13sp" android:insetTop="0dp" android:insetBottom="0dp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnSniffImportSignal"
                                style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="48dp"
                                android:text="导入信号表" android:textSize="13sp" android:insetTop="0dp" android:insetBottom="0dp" />
                        </com.icar.obd.ui.view.ColumnFlowLayout>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnMonitorToggle"
                            style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="48dp"
                            android:layout_marginTop="8dp" android:text="开启常驻监听" android:textSize="14sp" />
                        <TextView android:id="@+id/tvSniffMonitor" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary" android:textSize="13sp" android:lineSpacingExtra="2dp" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSniffHelp"
                        style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="使用说明" />
                    <LinearLayout android:id="@+id/sniffHelpBody" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:visibility="gone">
                        <TextView android:id="@+id/tvSniffHelp" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary" android:textSize="13sp" android:lineSpacingExtra="3dp" />
                        <TextView android:id="@+id/tvSniffFilterNote" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </ScrollView>
        <ScrollView android:id="@+id/sniffResultsScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="12dp" android:fillViewport="true">
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/bg_surface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="探测结果" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnSniffClear"
                            style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="清空结果" />
                    </LinearLayout>
                    <TextView android:id="@+id/tvSniffResultMeta" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary" android:textSize="13sp" android:layout_marginBottom="8dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSniffDiff"
                        style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="48dp"
                        android:text="对比上次采集" android:textSize="14sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="8dp">
                        <EditText android:id="@+id/etSniffSearch" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                            android:hint="查找 ID" android:inputType="textCapCharacters|textNoSuggestions" android:maxLength="10" android:textSize="14sp" android:singleLine="true" />
                        <Spinner android:id="@+id/spSniffSort" android:layout_width="wrap_content" android:layout_height="48dp" />
                    </LinearLayout>
                    <com.icar.obd.ui.view.ColumnFlowLayout android:id="@+id/sniffResults"
                        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                    <LinearLayout android:id="@+id/sniffDiffs" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
