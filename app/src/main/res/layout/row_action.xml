<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_input"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <Spinner
        android:id="@+id/spType"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1.4" />

    <EditText
        android:id="@+id/etP1"
        style="@style/InputEditMono"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:layout_weight="1.4"
        android:hint="参数1"
        android:importantForAutofill="no"
        android:minHeight="40dp"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etP2"
        style="@style/InputEditMono"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:hint="参数2"
        android:importantForAutofill="no"
        android:minHeight="40dp"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etP3"
        style="@style/InputEditMono"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:hint="参数3"
        android:importantForAutofill="no"
        android:minHeight="40dp"
        android:textSize="12sp" />

    <!--
      音效库（v1.20.21）：从**预设清单**里挑一个（名字说人话）。
      与右边的 📁（挑自己的音频文件）分工明确 ——
      之前只有 📁，用户得手打 `tick_left` 这种机器名才用得上预设。
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPickSound"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:minWidth="0dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="🎵"
        android:textSize="16sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPickAudio"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:minWidth="0dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="📁"
        android:textSize="16sp"
        android:visibility="gone" />

    <!--
      ▶ 预览（v1.20.21）：
        · 音效行 → 试听当前参数（速率/音量一起生效）
        · 弹提示行 → **真的弹一次灵动岛**（用当前样式 + 当前文案）
        · 系统通知行 → 真的发一条系统通知
      文案由 RuleEditorActivity.updateActionHints 按动作类型改写。
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPreview"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:minWidth="0dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="▶"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRemove"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:minWidth="0dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="×"
        android:textColor="@color/danger"
        android:textSize="16sp" />
</LinearLayout>
