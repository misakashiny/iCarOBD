<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!--
      id 是给 PidEditorActivity 的「校验失败要看得见」用的（v1.20.6，P10-2）：
      结果行在表单最底下，只改文字的话用户根本看不到 —— 需要能滚过去。
    -->
    <com.icar.obd.ui.view.MaxWidthScrollView
        android:id="@+id/scrollRoot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="center_horizontal"
        android:layout_weight="1"
        android:fillViewport="true"
        app:maxWidthDp="720dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="0dp"
                android:text="基本信息" />

            <TextView
                style="@style/FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="名称" />

            <EditText
                android:id="@+id/etName"
                style="@style/InputEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="例如：变速箱油温"
                android:importantForAutofill="no" />

            <TextView
                style="@style/FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="协议（仅备注与扫描过滤）" />

            <Spinner
                android:id="@+id/spProtocol"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_input" />

            <!--
              数据来源（v1.20.8，S3）。这是本轮补上的最大空白：
              在它出现之前，用户**造不出** source=monitor 的条目 ——
              全 app 只有 2 条内置监听 PID，第三条只能靠"导出信号表 → Excel 填 → 导回来"。
            -->
            <TextView
                style="@style/FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="数据来源" />

            <Spinner
                android:id="@+id/spSource"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_input" />

            <!--
              header 是**同一个字段、两种含义**（见 PidDraft 类注释）：
                poll    = AT SH 的目标模块头（7E0/720…，留空 = 广播 7DF）
                monitor = 广播帧的 CAN ID（09A/2C7…）
              所以标签与 hint 由代码按 source 换，不写死。
            -->
            <TextView
                android:id="@+id/tvHeaderLabel"
                style="@style/FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CAN 目标模块头（AT SH，留空 = 广播 7DF）" />

            <EditText
                android:id="@+id/etHeader"
                style="@style/InputEditMono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="7E0"
                android:importantForAutofill="no" />

            <TextView
                android:id="@+id/tvHeaderHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <!--
              Mode / PID：**监听型会整行隐藏**（v1.20.8，S3）。
              监听型的 mode 固定 MON、pid = header（见 PidDraft 类注释）——
              让人填一个保存时会被覆盖的值，比不显示它更糟。
            -->
            <LinearLayout
                android:id="@+id/rowModePid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mode（十六进制）" />

                    <EditText
                        android:id="@+id/etMode"
                        style="@style/InputEditMono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="22"
                        android:importantForAutofill="no" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1.4"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PID（十六进制，可带空格）" />

                    <EditText
                        android:id="@+id/etPid"
                        style="@style/InputEditMono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="1234"
                        android:importantForAutofill="no" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowRequest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="实际请求帧（自动生成，可覆盖）" />

                <EditText
                    android:id="@+id/etRequest"
                    style="@style/InputEditMono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="22 12 34"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="解析与换算" />

            <TextView
                style="@style/FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="公式（A..Z 为响应数据字节）" />

            <EditText
                android:id="@+id/etFormula"
                style="@style/InputEditMono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="((A * 256) + B) * 0.1 - 40"
                android:importantForAutofill="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTpl1"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="A"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTpl2"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="(A*256)+B"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTpl3"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="(A-128)*100/128"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTpl4"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="A-40"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTpl5"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="bit(A,0)"
                    android:textSize="11sp" />
            </LinearLayout>

            <!--
              监听型信号用的通用位段函数（v1.20.8，S3）。
              ⚠️ `bits(A,0,7)` 与 `bitsAt(...)` 名字太像，但**不是一回事**：
              `bits` 的输入是一个数值（只能取单字节内的位），`bitsAt` 自己拿整帧按位序遍历
              （跨字节 + 非对齐 + Motorola 都表达得了）。信号表生成的一律是 bitsAt 形态。
              把区别印在界面上，是因为**用错的表现是"解出别的信号的值，看起来却很正常"**。
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTplBitsAt"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="bitsAt(18,1,0,0)"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvFormulaHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="11sp"
                android:text="监听型信号常用 bitsAt(起始位, 长度, 字节序, 符号)：字节序 0=Intel(LE) / 1=Motorola(BE)，符号 0=无符号 / 1=有符号。⚠️ 它和 bits(A,起始位,长度) 不是一回事 —— 后者只能取单字节内的位。" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="单位" />

                    <EditText
                        android:id="@+id/etUnit"
                        style="@style/InputEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="℃"
                        android:importantForAutofill="no" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="最小值" />

                    <EditText
                        android:id="@+id/etMin"
                        style="@style/InputEditMono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned"
                        android:importantForAutofill="no" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="最大值" />

                    <EditText
                        android:id="@+id/etMax"
                        style="@style/InputEditMono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned"
                        android:importantForAutofill="no" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="报警下限（可空）" />

                    <EditText
                        android:id="@+id/etWarnLow"
                        style="@style/InputEditMono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned"
                        android:importantForAutofill="no" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="报警上限（可空）" />

                    <EditText
                        android:id="@+id/etWarnHigh"
                        style="@style/InputEditMono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned"
                        android:importantForAutofill="no" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowGroupInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="分组" />

                    <EditText
                        android:id="@+id/etGroup"
                        style="@style/InputEdit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="自定义"
                        android:importantForAutofill="no" />
                </LinearLayout>

                <!--
                  轮询间隔：**监听型会隐藏这一列**（v1.20.8，S3）。
                  监听型不进轮询列表（`FrameMonitor` 常驻监听驱动），
                  填了也没人读 —— 留着它只会让人以为"填小一点值就更新得快"。
                -->
                <LinearLayout
                    android:id="@+id/colInterval"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="轮询间隔 ms（0=跟随全局）" />

                    <EditText
                        android:id="@+id/etInterval"
                        style="@style/InputEditMono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:importantForAutofill="no" />
                </LinearLayout>
            </LinearLayout>

            <!-- 轮询优先级 + 多 ECU 序号：**监听型整行隐藏**（两者都只对主动请求有意义） -->
            <LinearLayout
                android:id="@+id/rowPriorityEcu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="轮询优先级（间隔=0 时才生效）" />

                    <Spinner
                        android:id="@+id/spPriority"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="多 ECU 取第几个响应（0 起）" />

                    <EditText
                        android:id="@+id/etEcuIndex"
                        style="@style/InputEditMono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:importantForAutofill="no" />
                </LinearLayout>
            </LinearLayout>

            <!--
              「让值不骗人」的三个字段（v1.20.8，S3 把它们接到界面上）。
              它们对应 S2 的三条运行时语义，语义与默认值见 PidDefinition 的字段注释。
              ⚠️ `显示超时` 只对监听型有意义（主动请求型每次轮询都是新值），
              所以切到 poll 时那一列会隐藏 —— 但**隐藏不等于清空**，
              编辑存量条目时它的值原样保留（隐藏的是显示，不是数据）。
            -->
            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="信号校验与新鲜度" />

            <LinearLayout
                android:id="@+id/rowSignalParams"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="无效原始值（可空）" />

                    <EditText
                        android:id="@+id/etInvalidRaw"
                        style="@style/InputEditMono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="255"
                        android:importantForAutofill="no"
                        android:inputType="number" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="最小帧长 DLC（0=不查）" />

                    <EditText
                        android:id="@+id/etMinDlc"
                        style="@style/InputEditMono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="8"
                        android:importantForAutofill="no"
                        android:inputType="number" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/colTtl"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="显示超时 ms（0=不判）" />

                    <EditText
                        android:id="@+id/etTtl"
                        style="@style/InputEditMono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="2000"
                        android:importantForAutofill="no"
                        android:inputType="number" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvSignalHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <TextView
                style="@style/FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="备注" />

            <EditText
                android:id="@+id/etNote"
                style="@style/InputEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="记录来源、字节序、验证情况…"
                android:importantForAutofill="no" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="启用（参与轮询）"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="测试（强烈建议保存前先测）" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="发送测试请求" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSample"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="连续采样（标定量程）" />

            <TextView
                android:id="@+id/tvTx"
                style="@style/MonoBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="TX: -" />

            <TextView
                android:id="@+id/tvRx"
                style="@style/MonoBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="RX: -" />

            <TextView
                android:id="@+id/tvBytes"
                style="@style/MonoBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="数据字节: -" />

            <TextView
                android:id="@+id/tvResult"
                style="@style/MonoBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="解析结果: -" />

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />
        </LinearLayout>
    </com.icar.obd.ui.view.MaxWidthScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:orientation="horizontal"
        android:padding="10dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDelete"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="删除"
            android:textColor="@color/danger" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="2"
            android:text="保存 PID" />
    </LinearLayout>
</LinearLayout>
