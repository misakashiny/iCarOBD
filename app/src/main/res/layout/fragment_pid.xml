<?xml version="1.0" encoding="utf-8"?>
<!--
  列表页根容器限宽：宽屏（横屏平板）下限制到 760dp 并居中。
  否则「名称在左、开关在右」会相隔上千 dp，扫读困难。
  竖屏窄屏不受影响，因此不需要 layout-land 副本。
-->
<com.icar.obd.ui.view.MaxWidthLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center_horizontal"
    android:background="@color/bg"
    android:orientation="vertical"
    app:maxWidthDp="760dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddPid"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="+ 新增 PID"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanner"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="PID 探测"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCanSniffer"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="CAN 探测"
            android:textSize="11sp" />

        <!--
          v1.19.22：探测记录 —— 把「PID 探测」与「CAN 探测」的结果都留档，
          方便事后翻（不用去几万行的日志里捞）。
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProbeLog"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="探测记录"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImport"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="导入 JSON"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExport"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="导出 JSON"
            android:textSize="11sp" />

        <!--
          清理重复（v1.20.12）：用户要求「检查 PID 页面、将重复多余的清除掉」。

          **默认 GONE** —— 没有重复时它根本不出现，不占位置、也不诱导用户去点。
          有重复时才显示成「清理 N 条重复」，点开是一个**逐条列出理由**的确认框
          （判据见 data/PidDedup.kt，纯逻辑有单测）。
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDedup"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="清理重复"
            android:textSize="11sp"
            android:visibility="gone" />


    </LinearLayout>

    <TextView
        android:id="@+id/tvPidHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="点击条目可编辑；开关控制是否参与轮询"
        android:textColor="@color/text_dim"
        android:textSize="11sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPids"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />
</com.icar.obd.ui.view.MaxWidthLinearLayout>
