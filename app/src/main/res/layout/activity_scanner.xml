<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PID 探测"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:textSize="18sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="待开始"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/tvProgress"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="80dp"
            android:layout_height="48dp"
            android:text="开始"
            android:textSize="13sp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStop"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="80dp"
            android:layout_height="48dp"
            android:text="停止"
            android:textSize="13sp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanSettings"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:text="设置"
            android:textSize="13sp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanBack"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:text="返回"
            android:textSize="13sp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>
    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginBottom="8dp"
        android:max="100" />
    <LinearLayout
        android:id="@+id/scanColumns"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <ScrollView
            android:id="@+id/scanSettingsScroll"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:background="@drawable/bg_card"
            android:fillViewport="false">
            <LinearLayout
                android:id="@+id/scanForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="扫描范围"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold" />
                <Spinner android:id="@+id/spMode" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="起始 PID · 十六进制"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />
                        <EditText
                            android:id="@+id/etFrom"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="00"
                            android:inputType="textCapCharacters|textNoSuggestions"
                            android:textSize="14sp"
                            android:singleLine="true"
                            android:fontFamily="monospace"
                            android:importantForAutofill="no" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="结束 PID · 十六进制"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />
                        <EditText
                            android:id="@+id/etTo"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="C0"
                            android:inputType="textCapCharacters|textNoSuggestions"
                            android:textSize="14sp"
                            android:singleLine="true"
                            android:fontFamily="monospace"
                            android:importantForAutofill="no" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="请求 ECU · CAN ID"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />
                        <EditText
                            android:id="@+id/etScanHeader"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="7DF"
                            android:inputType="textCapCharacters|textNoSuggestions"
                            android:textSize="14sp"
                            android:singleLine="true"
                            android:fontFamily="monospace"
                            android:importantForAutofill="no" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="读取请求上限"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />
                        <EditText
                            android:id="@+id/etMax"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="400"
                            android:inputType="number"
                            android:textSize="14sp"
                            android:singleLine="true"
                            android:fontFamily="monospace"
                            android:importantForAutofill="no" />
                    </LinearLayout>
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swBitmap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:checked="true"
                    android:text="先查支持位图 · 推荐"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="含位图、重试和额外采样；未响应不等于不支持。"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="车辆已安全停放，我确认开始探测"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="主动探测会发送读取请求；开始后暂停轮询。"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:id="@+id/tvWarning" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScanAdvanced"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="高级参数"
                    android:textSize="13sp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
                <LinearLayout
                    android:id="@+id/scanAdvanced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="间隔 ms"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary" />
                            <EditText
                                android:id="@+id/etInterval"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:text="150"
                                android:inputType="number"
                                android:textSize="14sp"
                                android:singleLine="true"
                                android:fontFamily="monospace"
                                android:importantForAutofill="no" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="超时 ms"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary" />
                            <EditText
                                android:id="@+id/etTimeout"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:text="1500"
                                android:inputType="number"
                                android:textSize="14sp"
                                android:singleLine="true"
                                android:fontFamily="monospace"
                                android:importantForAutofill="no" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="失败重试"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary" />
                            <EditText
                                android:id="@+id/etRetry"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:text="1"
                                android:inputType="number"
                                android:textSize="14sp"
                                android:singleLine="true"
                                android:fontFamily="monospace"
                                android:importantForAutofill="no" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="额外采样 · 0关闭"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary" />
                            <EditText
                                android:id="@+id/etLearn"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:text="0"
                                android:inputType="number"
                                android:textSize="14sp"
                                android:singleLine="true"
                                android:fontFamily="monospace"
                                android:importantForAutofill="no" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="排除项 · 逗号分隔，如 01:0C"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary" />
                    <EditText
                        android:id="@+id/etBlacklist"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="01:02,01:03,01:07,01:0A"
                        android:textSize="13sp"
                        android:inputType="textCapCharacters|textNoSuggestions"
                        android:singleLine="true"
                        android:importantForAutofill="no" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="间隔30–10000ms，超时200–10000ms；重试0–3，采样0–20。采样值只作参考。"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:id="@+id/scanResults"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/bg_card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvScanResults"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="探测结果 · 0条"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExport"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="64dp"
                    android:layout_height="48dp"
                    android:text="导出"
                    android:textSize="13sp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:enabled="false" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="命中只说明收到应答。公式、单位和用途需要核实。"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="还没有探测结果。设置范围后开始。"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/tvScanEmpty"
                android:layout_marginTop="16dp" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHits"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanLog"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="过程记录"
                android:textSize="13sp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
            <ScrollView android:id="@+id/scanLogScroll" android:layout_width="match_parent" android:layout_height="100dp" android:visibility="gone">
                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:textIsSelectable="true" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
