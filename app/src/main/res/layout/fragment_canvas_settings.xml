<?xml version="1.0" encoding="utf-8"?>
<!--
  画布设置页（ViewPager2 的**最后一页**，滑到最右）。

  它是 v1.19.25 删掉的那条顶栏的去处：
  「布局（预设）/ 风格（主题·背景·设计文件·参考线）」原本是顶栏上两个按钮，
  现在全部收进这一页 —— 顺带把「多套画布」的管理也放在这里，
  因为"管理画布"和"调这一套的样子"本来就是同一件事。

  ## ⚠️ 为什么外面多套了一层 FrameLayout（v1.20.2 修）

  `MaxWidthNestedScrollView` 的限宽**靠父容器认 `layout_gravity` 来居中**
  （见 `MaxWidthViews.kt` 的说明）。而这一页的父容器是 **ViewPager2** ——
  `FragmentStateAdapter.addViewToContainer()` 给页面根视图套的是
  `FrameLayout.LayoutParams(MATCH_PARENT, MATCH_PARENT)`，**把 gravity 覆盖掉了**，
  于是限宽生效、居中失效，整页靠左（实测：内容 x=250..1770，而页面是 200..2560）。

  所以这里自己套一层 FrameLayout 来提供居中 —— 它由**本布局**控制，
  不会被 pager 改写。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

<com.icar.obd.ui.view.MaxWidthNestedScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center_horizontal"
    android:background="@color/bg"
    android:fillViewport="true"
    app:maxWidthDp="720dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- ==================== 画布列表 ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="画布（横滑切换）"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCanvasCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <!-- 行由 CanvasSettingsFragment 动态生成（见 item_canvas.xml） -->
            <LinearLayout
                android:id="@+id/llCanvasList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddCanvas"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="＋ 新增画布"
                android:textSize="13sp" />

            <!--
                导入 / 导出画布：与 `tools/theme-studio/`（网页版主题制作工具）对接的入口。
                刻意做成**紧挨「新增画布」的一行** —— 三件事是同一类操作
                （"再来一套 / 从文件来一套 / 把这一套带走"），放一起才找得到。
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnImportCanvas"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="导入画布"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportCanvas"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="导出画布"
                    android:textSize="13sp" />
            </LinearLayout>

            <!--
                最近一次导入（v1.20.6）：文件名 / 几块表 / 时间。

                为什么要有这一行：用户报过两次"导入之后画布还是空的"，查半天
                才发现是**根本没导进去**。以前界面上没有任何"上次导了什么"的痕迹，
                只能翻日志 —— 这一行就是那个缺失的痕迹（且重启后还在）。
            -->
            <TextView
                android:id="@+id/tvLastImport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ==================== 当前画布外观 ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前画布"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCurrentCanvas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCanvasTheme"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="画布主题"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCanvasLook"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="背景 / 设计文件 / 参考线…"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ==================== 全局设置 ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全局（与画布无关）"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPollInterval"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="轮询间隔"
                android:textSize="13sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swSound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="音效（规则触发时的提示音）"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNameLabel"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="画布名浮标"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="4dp"
            android:text="提示：编辑在每套画布的「操作」菜单里（编辑这一套…）；编辑时横滑会被禁用（拖表盘与翻页会打架）。\n「导入画布 / 导出画布」对接电脑上的 tools/theme-studio 主题制作工具。"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />
    </LinearLayout>
</com.icar.obd.ui.view.MaxWidthNestedScrollView>
</FrameLayout>
