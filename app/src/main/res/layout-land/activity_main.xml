<?xml version="1.0" encoding="utf-8"?>
<!--
  横屏主界面。

  与竖屏（res/layout/activity_main.xml）的唯一结构差异：
  底部导航被换成**左侧竖排导航（NavigationRailView）**。

  为什么：横屏下垂直像素只有竖屏的 62%（1600 vs 2560），
  底部导航会吃掉约 180px（≈8% 屏高），而左侧导航占用的是富余的水平像素。
  另外横屏下拇指/手指从左侧点按更自然。

  两个布局使用**相同的 id**（navView / statusBar / pageContainer / connDot /
  tvStatus / tvRate），MainActivity 用 NavigationBarView 基类接收导航控件，
  因此不需要写任何 if(横屏) 分支。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal">

    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@+id/navView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:background="@color/bg_surface"
        android:minWidth="88dp"
        app:itemActiveIndicatorStyle="@style/Widget.Material3.NavigationRailView.ActiveIndicator"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav"
        app:menuGravity="center" />

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">


        <FrameLayout
            android:id="@+id/pageContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

</LinearLayout>
