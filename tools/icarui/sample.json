{
  "schema": "icar.ui/1",
  "meta": {
    "name": "赛道模式",
    "author": "iCarOBD",
    "description": "示例：混合盘面（圆表 + 数字 + 条形），带指针环、霓虹档位与卡片外框覆盖。"
  },
  "theme": "neon",
